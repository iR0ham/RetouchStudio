<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Retouch Studio desktop host for Windows. WPF is in-box with the .NET
    SDK: no Windows App SDK bootstrapper, no MSIX tooling and no third-party
    package, so the published folder runs from a zip and every dependency is
    either the .NET runtime or Microsoft's own.

    The stack decision and this deviation from the earlier WinUI 3
    recommendation are recorded in Docs/WINDOWS_IMPLEMENTATION_PATH.md.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RetouchStudio.App</RootNamespace>
    <AssemblyName>RetouchStudio</AssemblyName>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetouchStudio.Core\RetouchStudio.Core.csproj" />
    <ProjectReference Include="..\RetouchStudio.Imaging\RetouchStudio.Imaging.csproj" />
    <!-- The protocol library ships with the host so a later W5-2 UI can start
         the same contained runtime the tests prove. The worker executable is
         published into AI/ by Tools/build-windows.ps1. -->
    <ProjectReference Include="..\RetouchStudio.AI\RetouchStudio.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model catalog is data, not code. The same file ships with macOS. -->
    <None Include="..\..\Resources\model-catalog.json" Link="model-catalog.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
