<Window x:Class="RetouchStudio.App.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Models" Width="760" Height="660" MinWidth="640" MinHeight="480"
        Background="{StaticResource ShellBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel>
        <TextBlock Text="AI Models" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" />
        <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource ToolButton}"
                Click="Done_Click" HorizontalAlignment="Right" />
      </DockPanel>
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                 Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                 Text="Models run on this PC. Nothing is uploaded, and no model is downloaded without your approval." />
      <TextBlock x:Name="DiskText" Margin="0,8,0,0" FontSize="11"
                 Foreground="{StaticResource MutedBrush}" />
      <TextBlock x:Name="NoticeText" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                 Foreground="{StaticResource AccentBrush}" />
      <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" x:Name="ProgressPanel" Visibility="Collapsed"
            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource ToolButton}"
                  Click="Cancel_Click" />
          <TextBlock x:Name="ProgressLabel" FontSize="12" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <ProgressBar x:Name="TransferBar" Height="6" Margin="0,8,0,0"
                     Foreground="{StaticResource AccentBrush}"
                     Background="{StaticResource LineBrush}" />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="RowsPanel" />
    </ScrollViewer>
  </DockPanel>
</Window>
