<Application x:Class="RetouchStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="ShellBrush" Color="#17191B" />
    <SolidColorBrush x:Key="PanelBrush" Color="#212528" />
    <SolidColorBrush x:Key="LineBrush" Color="#32383D" />
    <SolidColorBrush x:Key="TextBrush" Color="#E9ECEF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#98A2AA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#C8F135" />
    <SolidColorBrush x:Key="SkyBrush" Color="#7FD4F5" />

    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#252A2E" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush"
                        Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#2E353A" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Foreground" Value="#101214" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,8" />
    </Style>

    <Style x:Key="SliderText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Resources>
</Application>
