<Window x:Class="RetouchStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1280" Height="840" MinWidth="960" MinHeight="620"
        Background="{StaticResource ShellBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Deactivated="Window_Deactivated">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
            Padding="12,8">
      <StackPanel Orientation="Horizontal">
        <Button Content="Open Photo" Style="{StaticResource PrimaryButton}" Click="OpenPhoto_Click" />
        <Button Content="Open Project" Style="{StaticResource ToolButton}" Click="OpenProject_Click" />
        <Button Content="Save Project" Style="{StaticResource ToolButton}" Click="Save_Click" />
        <Button Content="Export" Style="{StaticResource ToolButton}" Click="Export_Click"
                IsEnabled="{Binding CanStartExport}" />
        <Button Content="Batch Export…" Style="{StaticResource ToolButton}" Click="BatchExport_Click"
                IsEnabled="{Binding CanStartBatch}" />
        <Button Content="Cancel Batch" Style="{StaticResource ToolButton}" Click="CancelBatch_Click"
                IsEnabled="{Binding IsBatchRunning}"
                ToolTip="Stop the batch before its next photo" />
        <Border Width="1" Background="{StaticResource LineBrush}" Margin="6,2,12,2" />
        <Button Content="Undo" Style="{StaticResource ToolButton}" Click="Undo_Click"
                IsEnabled="{Binding CanUndo}" />
        <Button Content="Redo" Style="{StaticResource ToolButton}" Click="Redo_Click"
                IsEnabled="{Binding CanRedo}" />
        <Border Width="1" Background="{StaticResource LineBrush}" Margin="6,2,12,2" />
        <Button Content="Rotate Left" Style="{StaticResource ToolButton}" Click="RotateLeft_Click" />
        <Button Content="Rotate Right" Style="{StaticResource ToolButton}" Click="RotateRight_Click" />
        <Button Content="Flip" Style="{StaticResource ToolButton}" Click="Flip_Click" />
        <Border Width="1" Background="{StaticResource LineBrush}" Margin="6,2,12,2" />
        <ToggleButton x:Name="CompareToggle" Content="Compare" IsChecked="False"
                      Style="{StaticResource ToolToggle}" Click="CompareToggle_Click"
                      IsEnabled="{Binding HasDocument}"
                      AutomationProperties.Name="Compare before and after"
                      ToolTip="Show the untouched photo left of the split" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
            Padding="12,5">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="Cancel Export" Style="{StaticResource ToolButton}"
                Click="CancelExport_Click" IsEnabled="{Binding IsExportRunning}"
                Margin="0,0,10,0"
                ToolTip="Stop the export before it publishes the photo" />
        <Button DockPanel.Dock="Left" Content="AI Models…" Style="{StaticResource ToolButton}"
                Click="OpenModels_Click" Margin="0,0,10,0"
                ToolTip="Download, verify, switch or remove local AI models" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding DimensionText}"
                   Foreground="{StaticResource MutedBrush}" FontSize="11" />
        <TextBlock DockPanel.Dock="Right" Text="·  drag to pan · Ctrl+wheel to zoom · hold Space to compare  ·"
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   Margin="0,0,10,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasDocument}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextBrush}"
                   FontSize="11" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="336" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#0E1012" Margin="10" CornerRadius="6">
        <Grid x:Name="PreviewHost" ClipToBounds="True" Background="Transparent"
              AllowDrop="True" DragOver="PreviewHost_DragOver" Drop="PreviewHost_Drop"
              MouseLeftButtonDown="PreviewHost_MouseLeftButtonDown"
              MouseMove="PreviewHost_MouseMove"
              MouseLeftButtonUp="PreviewHost_MouseLeftButtonUp"
              MouseWheel="PreviewHost_MouseWheel"
              LostMouseCapture="PreviewHost_LostMouseCapture">
          <TextBlock Text="Drop a photo or project here, or open one from the top bar."
                     Foreground="{StaticResource MutedBrush}" FontSize="13"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasDocument}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Grid x:Name="PhotoPlane" Margin="18" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="PreviewScale" />
                <TranslateTransform x:Name="PreviewPan" />
              </TransformGroup>
            </Grid.RenderTransform>
            <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform" />
            <Image x:Name="PreviewOriginal" Source="{Binding OriginalPreview}"
                   Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed" />
          </Grid>
          <Canvas x:Name="CompareOverlay" Visibility="Collapsed">
            <Line x:Name="CompareLine" Stroke="#E6F4F7F9" StrokeThickness="1"
                  IsHitTestVisible="False" />
            <Border x:Name="CompareBeforeBadge" Background="#CC0B0D0F" CornerRadius="3"
                    Padding="5,2" IsHitTestVisible="False">
              <TextBlock Text="BEFORE" Foreground="{StaticResource MutedBrush}" FontSize="9" />
            </Border>
            <Border x:Name="CompareAfterBadge" Background="#CC0B0D0F" CornerRadius="3"
                    Padding="5,2" IsHitTestVisible="False">
              <TextBlock Text="AFTER" Foreground="{StaticResource AccentBrush}" FontSize="9" />
            </Border>
            <Thumb x:Name="CompareThumb" Style="{StaticResource CompareHandle}"
                   AutomationProperties.Name="Compare split"
                   DragDelta="CompareThumb_Drag" />
          </Canvas>
          <Border x:Name="ZoomDock" Background="#B30B0D0F" CornerRadius="5"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  Padding="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,14,12">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasDocument}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ZoomFitButton" Content="Fit" Style="{StaticResource ToolButton}"
                      Padding="7,2" FontSize="11" Click="ZoomFit_Click"
                      AutomationProperties.Name="Fit to window"
                      ToolTip="Fit to window (Ctrl+0)" />
              <Button x:Name="ZoomOutButton" Content="−" Style="{StaticResource ToolButton}"
                      Padding="7,2" FontSize="12" Click="ZoomOut_Click"
                      AutomationProperties.Name="Zoom out"
                      ToolTip="Zoom out (Ctrl+-)" />
              <TextBlock x:Name="ZoomText" Text="Fit" Foreground="{StaticResource TextBrush}"
                         FontSize="11" MinWidth="40" TextAlignment="Center"
                         VerticalAlignment="Center" />
              <Button x:Name="ZoomInButton" Content="+" Style="{StaticResource ToolButton}"
                      Padding="7,2" FontSize="12" Click="ZoomIn_Click"
                      AutomationProperties.Name="Zoom in"
                      ToolTip="Zoom in (Ctrl++)" />
            </StackPanel>
          </Border>
          <Canvas x:Name="CropOverlay" Visibility="Collapsed" ClipToBounds="True">
            <Rectangle x:Name="CropShadeTop" Fill="#8C0B0D0F" IsHitTestVisible="False" />
            <Rectangle x:Name="CropShadeBottom" Fill="#8C0B0D0F" IsHitTestVisible="False" />
            <Rectangle x:Name="CropShadeLeft" Fill="#8C0B0D0F" IsHitTestVisible="False" />
            <Rectangle x:Name="CropShadeRight" Fill="#8C0B0D0F" IsHitTestVisible="False" />
            <Rectangle x:Name="CropFrame" Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="1.5" StrokeDashArray="5 3" IsHitTestVisible="False" />
            <Line x:Name="CropThirdV1" Stroke="#57FFFFFF" StrokeThickness="0.5"
                  IsHitTestVisible="False" />
            <Line x:Name="CropThirdV2" Stroke="#57FFFFFF" StrokeThickness="0.5"
                  IsHitTestVisible="False" />
            <Line x:Name="CropThirdH1" Stroke="#57FFFFFF" StrokeThickness="0.5"
                  IsHitTestVisible="False" />
            <Line x:Name="CropThirdH2" Stroke="#57FFFFFF" StrokeThickness="0.5"
                  IsHitTestVisible="False" />
            <Thumb x:Name="CropBody" Style="{StaticResource CropBody}"
                   AutomationProperties.Name="Crop frame"
                   DragDelta="CropBody_Drag" />
            <Border x:Name="CropBadge" Background="#CC0B0D0F" CornerRadius="3"
                    Padding="7,3" IsHitTestVisible="False">
              <TextBlock x:Name="CropBadgeText" Foreground="{StaticResource TextBrush}"
                         FontSize="10" />
            </Border>
            <Thumb x:Name="CropTopLeft" AutomationProperties.Name="Crop corner handle" Tag="TopLeft" Style="{StaticResource CropHandle}"
                   Cursor="SizeNWSE" DragDelta="CropHandle_Drag" />
            <Thumb x:Name="CropTopRight" AutomationProperties.Name="Crop corner handle" Tag="TopRight" Style="{StaticResource CropHandle}"
                   Cursor="SizeNESW" DragDelta="CropHandle_Drag" />
            <Thumb x:Name="CropBottomLeft" AutomationProperties.Name="Crop corner handle" Tag="BottomLeft" Style="{StaticResource CropHandle}"
                   Cursor="SizeNESW" DragDelta="CropHandle_Drag" />
            <Thumb x:Name="CropBottomRight" AutomationProperties.Name="Crop corner handle" Tag="BottomRight" Style="{StaticResource CropHandle}"
                   Cursor="SizeNWSE" DragDelta="CropHandle_Drag" />
          </Canvas>
          <StackPanel x:Name="CropBar" Visibility="Collapsed" Orientation="Horizontal"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
            <Button Content="Apply crop" Style="{StaticResource PrimaryButton}"
                    Click="CropApply_Click" />
            <Button Content="Cancel" Style="{StaticResource ToolButton}"
                    Click="CropCancel_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,16,16">
          <StackPanel>
            <TextBlock Text="HISTOGRAM" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <Border Height="92" Background="#101214" CornerRadius="4"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Padding="1">
              <Viewbox Stretch="Fill">
                <Canvas Width="256" Height="100">
                  <Line X1="0" Y1="50" X2="256" Y2="50" Stroke="#1E242A"
                        StrokeThickness="1" />
                  <Polyline Points="{Binding HistogramRed}" Stroke="#E2564F"
                            StrokeThickness="1.1" />
                  <Polyline Points="{Binding HistogramGreen}" Stroke="#6FD08C"
                            StrokeThickness="1.1" />
                  <Polyline Points="{Binding HistogramBlue}" Stroke="#6FA8F0"
                            StrokeThickness="1.1" />
                  <Polyline Points="{Binding HistogramLuma}" Stroke="#DDE3E8"
                            StrokeThickness="1.1" Opacity="0.65" />
                </Canvas>
              </Viewbox>
            </Border>

            <TextBlock Text="LIGHT &amp; COLOR" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Adjustments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,8">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}"
                                 Foreground="{StaticResource SkyBrush}" FontSize="12" />
                      <TextBlock Text="{Binding Label}" Style="{StaticResource SliderText}" />
                    </DockPanel>
                    <Slider Minimum="-100" Maximum="100" Margin="0,2,0,0"
                            AutomationProperties.Name="{Binding Label}"
                            Value="{Binding Value, Mode=TwoWay}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Reset sliders" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Style="{StaticResource ToolButton}" Click="Reset_Click" />

            <TextBlock Text="STRAIGHTEN" Style="{StaticResource SectionTitle}" />
            <DockPanel>
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding StraightenAngle, StringFormat={}{0:0.0}°}"
                         Foreground="{StaticResource SkyBrush}" FontSize="12" />
              <TextBlock Text="Angle" Style="{StaticResource SliderText}" />
            </DockPanel>
            <Slider Minimum="-45" Maximum="45" TickFrequency="0.5"
                    Margin="0,2,0,0" AutomationProperties.Name="Straighten angle"
                    Value="{Binding StraightenAngle, Mode=TwoWay}" />

            <TextBlock Text="CROP" Style="{StaticResource SectionTitle}" />
            <WrapPanel>
              <Button Content="Original" Tag="original" Style="{StaticResource ToolButton}"
                      Margin="0,0,6,6" Click="Crop_Click" />
              <Button Content="Square" Tag="square" Style="{StaticResource ToolButton}"
                      Margin="0,0,6,6" Click="Crop_Click" />
              <Button Content="4:5" Tag="4:5" Style="{StaticResource ToolButton}"
                      Margin="0,0,6,6" Click="Crop_Click" />
              <Button Content="3:2" Tag="3:2" Style="{StaticResource ToolButton}"
                      Margin="0,0,6,6" Click="Crop_Click" />
              <Button Content="16:9" Tag="16:9" Style="{StaticResource ToolButton}"
                      Margin="0,0,6,6" Click="Crop_Click" />
              <Button Content="Custom…" Style="{StaticResource ToolButton}"
                      Margin="0,0,6,6" Click="CropCustom_Click" />
            </WrapPanel>
            <TextBlock Text="{Binding CropLabel}" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" Margin="0,2,0,0" />

            <TextBlock Text="EXPORT" Style="{StaticResource SectionTitle}" />
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Format" Style="{StaticResource SliderText}" />
              <ComboBox x:Name="FormatBox" DockPanel.Dock="Right" Width="130"
                        SelectedValuePath="Tag"
                        SelectedValue="{Binding ExportFormat, Mode=TwoWay}">
                <ComboBoxItem Content="JPEG" Tag="jpeg" />
                <ComboBoxItem Content="PNG" Tag="png" />
                <ComboBoxItem Content="TIFF" Tag="tiff" />
              </ComboBox>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Long edge" Style="{StaticResource SliderText}" />
              <ComboBox x:Name="LongEdgeBox" DockPanel.Dock="Right" Width="130"
                        SelectedIndex="{Binding LongEdgeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Original" />
                <ComboBoxItem Content="4096 px" />
                <ComboBoxItem Content="2048 px" />
                <ComboBoxItem Content="1080 px" />
              </ComboBox>
            </DockPanel>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding ExportQuality, StringFormat={}{0:P0}}"
                         Foreground="{StaticResource SkyBrush}" FontSize="12" />
              <TextBlock Text="Quality" Style="{StaticResource SliderText}" />
            </DockPanel>
            <Slider Minimum="0.4" Maximum="1" SmallChange="0.01" Margin="0,2,0,0"
                    Value="{Binding ExportQuality, Mode=TwoWay}" />
            <CheckBox Content="Keep camera metadata (camera model, ISO)"
                      Margin="0,10,0,0" FontSize="12"
                      Foreground="{StaticResource MutedBrush}"
                      IsChecked="{Binding KeepSourceMetadata, Mode=TwoWay}" />

            <TextBlock Text="The Windows host writes JPEG, and 16-bit PNG and TIFF, applies the nine global sliders, crop and orientation, and keeps the project file format shared with macOS. Exports keep only the resolution unless you choose to keep camera metadata, which carries the camera model and ISO. AI tools, healing and stickers are not part of this host yet."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" Margin="0,16,0,0" LineHeight="16" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
