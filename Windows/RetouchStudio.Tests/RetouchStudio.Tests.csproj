<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless checks for the Windows host. The console app runs against the real
    studioscore_core.dll and the real WIC codec, so passing here is evidence
    about what ships, not about a stand-in. Tools/build-windows.ps1 builds the
    native library, publishes the app and then runs this project.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>RetouchStudio.Tests</RootNamespace>
    <AssemblyName>RetouchStudio.Tests</AssemblyName>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetouchStudio.Core\RetouchStudio.Core.csproj" />
    <ProjectReference Include="..\RetouchStudio.Imaging\RetouchStudio.Imaging.csproj" />
  </ItemGroup>
</Project>
