<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Windows AI runtime: protocol 2 framing, the ONNX Runtime CPU execution
    provider and the readiness registry. It is a plain net10.0 library so the
    protocol can be built and inspected without WPF; the worker executable and
    the host both reference it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RetouchStudio.AI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned baseline approved for W5. Keep the version, published size and
         nupkg SHA-256 in Windows/README.md in sync. CPU is the only required
         execution provider; DirectML is never mandatory. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
  </ItemGroup>
</Project>
