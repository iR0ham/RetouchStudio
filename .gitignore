# macOS
.DS_Store

# Build output
build/
.build/
*.app
*.dSYM
*.xcuserstate
Windows/**/bin/
Windows/**/obj/

# Worker environments and bytecode (the source and locks are tracked)
worker/.venv/
worker/**/__pycache__/
worker/**/*.pyc
# The *.app rule above is for macOS bundles; the Windows host's project
# directory happens to end in .App, so re-include it explicitly.
!Windows/RetouchStudio.App/

# Local-only portrait fixtures (personal photos; never publish)
Tests/Fixtures/private/
Tests/Fixtures/portraits/

# Editor / tooling
.vscode/
.idea/

# Release packages
*.dmg
*.dmg.sha256
# make-dmg.sh also writes an absolute-path provenance companion next to the
# portable sidecar. It is deliberately not named *.sha256, and it is still a
# build artefact, so it must not surface as an untracked file either.
*.dmg.sha256.abs
*.zip
*.zip.sha256
